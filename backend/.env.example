# FastAPI auth configuration
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-entra-client-secret
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_SCOPES=[ openid,profile,offline_access]

# Token storage (Key Vault preferred)
KEY_VAULT_URI=
SESSION_SIGNING_KEY_NAME=
TOKEN_STORE_ENCRYPTION_KEY=replace-with-32-byte-base64-key
TOKEN_STORE_DB_PATH=.secure_tokens.db
SESSION_SIGNING_KEY=replace-with-hs256-secret
SESSION_JWT_TTL_MINUTES=15

# API access
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Copilot Studio Agent
COPILOTSTUDIOAGENT__ENVIRONMENTID=
COPILOTSTUDIOAGENT__SCHEMANAME=
COPILOTSTUDIOAGENT__AGENTAPPID=
COPILOTSTUDIOAGENT__TENANTID=
