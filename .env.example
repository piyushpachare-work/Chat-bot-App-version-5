# Application defaults (Node/Express)
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-with-entra-client-secret
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback
AZURE_KEY_VAULT_URL=
MICROSOFT_365_SCOPE=https://graph.microsoft.com/.default

# Session & security
SESSION_SIGNING_KEY=replace-with-random-32-char-secret
SESSION_SIGNING_KEY_NAME=
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
NODE_ENV=development

# Copilot Studio Agent
COPILOTSTUDIOAGENT__ENVIRONMENTID=
COPILOTSTUDIOAGENT__SCHEMANAME=
COPILOTSTUDIOAGENT__AGENTAPPID=
COPILOTSTUDIOAGENT__TENANTID=
